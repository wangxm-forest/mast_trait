  ")"
)

fix_unicode <- function(x) {
  x <- gsub("\u2212", "-", x)
  x <- gsub("–", "-", x)
  x <- gsub("—", "-", x)
  x <- gsub("%", "\\\\%", x)
  x <- gsub("\\balpha\\b", "$\\\\alpha$", x)
  x <- gsub("\\blambda\\b", "$\\\\lambda$", x)
  x
}

angio_results[] <- lapply(angio_results, function(x) {
  if (is.character(x))
    fix_unicode(x)
  else
    x
})

colnames(angio_results) <-
    fix_unicode(colnames(angio_results))

conifer_results[] <- lapply(conifer_results, function(x) {
  if (is.character(x))
    fix_unicode(x)
  else
    x
})

colnames(conifer_results) <-
    fix_unicode(colnames(conifer_results))

seed_results[] <- lapply(seed_results, function(x) {
  if (is.character(x))
    fix_unicode(x)
  else
    x
})

colnames(seed_results) <-
    fix_unicode(colnames(seed_results))


lambda[] <- lapply(lambda, function(x) {
  if (is.character(x))
    fix_unicode(x)
  else
    x
})

colnames(lambda) <-
    fix_unicode(colnames(lambda))

pWeight <- angio_results$P[angio_results$Predictor=="Seed weight (log)"]
pWind <-  angio_results$P[angio_results$Predictor=="Wind vs. animal"]

p_mastingWeight <- plogis(b0 + b1 * log(medianWeight))
p_mastingWeight3 <- plogis(b0 + b1 * log(medianWeight*3))
p_mastingBioWeight <- plogis(b0_bio + b1_bio * log(medianBioWeight))
p_mastingBioWeight3 <- plogis(b0_bio + b1_bio * log(medianBioWeight*3))

p_animal <- plogis(animalLikelihood)
p_wind <- plogis(animalLikelihood + windLikelihood)

angioWeightLambda <- as.numeric(lambda[["$\\lambda$"]][lambda$Group=="Angiosperm" & lambda$Trait=="Seed weight (Log)"])
gymnoWeightLambda <- as.numeric(lambda[["$\\lambda$"]][lambda$Group=="Gymnosperm" & lambda$Trait=="Seed weight (Log)"])

mastAngioD <- dStat$`Estimated D`[dStat$Group=="Angiosperm" & dStat$Trait=="Masting"]
mastGymnoD <- dStat$`Estimated D`[dStat$Group=="Gymnosperm" & dStat$Trait=="Masting"]

@

