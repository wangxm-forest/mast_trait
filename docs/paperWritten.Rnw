angioTable <- xtable(angio_results, 
                 caption = "Phylogenetic generalized linear model results for gymnosperm species. We modeled each trait separately with masting as a binary variable and traits as either categorical or continuous (Type column). For categorical traits, we report the the difference in log-odds between a given level and its designated baseline reference level; for continuous traits, we report the change in log-odds per unit increase of the predictor (Estimate column). We also report the standard error (SE), P-value (with P < 0.05 considered significant and marked with an asterisk next to the Predictor) and the half-life. The half-life represents the time required for the influence of ancestral states to decrease by half; where larger values suggests the residuals are more affected by phylogenetic history than the environment (and vice versa for smaller values). Given out trees are scaled to 1, a value near 1 thus means phylogenetic correlation persists across the phylogenetic depth. For more inerpretation, see cooper2016cautionary.", 
                 label = "tab:regressionangio")
print(angioTable,
      type="latex",
      include.rownames=FALSE,
      floating=FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = identity)
@
}
\caption{Phylogenetic generalized linear model results for angiosperm species. We modeled each trait separately with masting as a binary variable and traits as either categorical or continuous (Type column). For categorical traits, we report the the difference in log-odds between a given level and its designated baseline reference level; for continuous traits, we report the change in log-odds per unit increase of the predictor (Estimate column). We also report the standard error (SE), P-value (with P < 0.05 considered significant and marked with an asterisk next to the Predictor) and the half-life. The half-life represents the time required for the influence of ancestral states to decrease by half; where larger values suggests the residuals are more affected by phylogenetic history than the environment (and vice versa for smaller values). Given out trees are scaled to 1, a value near 1 thus means phylogenetic correlation persists across the phylogenetic depth. For more inerpretation, see \cite{cooper2016cautionary}.}
\label{tab:regressionangio}
\end{table}

