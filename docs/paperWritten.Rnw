\begin{center}
{\sc Title:} {Evolutionary Explanations for Masting: Linking Traits to Competing Hypotheses from Pollination to Seed Survival} \\
\vspace{5ex}

{\sc Authors:} Xiaomao Wang$^1$, E.M. Wolkovich$^1$
