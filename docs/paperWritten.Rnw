                 caption = "Phylogenetic generalized linear model results for gymnosperm species. We modeled each trait separately with masting as a binary variable and traits as either categorical or continuous (Type column). For categorical traits, we report the the difference in log-odds between a given level and its designated baseline reference level; for continuous traits, we report the change in log-odds per unit increase of the predictor (Estimate column). We also report the standard error (SE), P-value (with P < 0.05 considered significant and marked with an asterisk next to the Predictor) and the half-life. The half-life represents the time required for the influence of ancestral states to decrease by half; where larger values suggests the residuals are more affected by phylogenetic history than the environment (and vice versa for smaller values). Given our trees are scaled to 1, a value near 1 thus means phylogenetic correlation persists across the phylogenetic depth. For more inerpretation, see cooper2016cautionary.", 
                 label = "tab:regressiongym")
print(conTable,
      type="latex",
      include.rownames=FALSE,
      floating=FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = identity)
@
}
\caption{Phylogenetic generalized linear model results for gymnosperm species. We modeled each trait separately with masting as a binary variable and traits as either categorical or continuous (Type column). For categorical traits, we report the the difference in log-odds between a given level and its designated baseline reference level; for continuous traits, we report the change in log-odds per unit increase of the predictor (Estimate column). We also report the standard error (SE), P-value (with P < 0.05 considered significant and marked with an asterisk next to the Predictor) and the half-life. The half-life represents the time required for the influence of ancestral states to decrease by half; where larger values suggests the residuals are more affected by phylogenetic history than the environment (and vice versa for smaller values). Given our trees are scaled to 1, a value near 1 thus means phylogenetic correlation persists across the phylogenetic depth, and values much higher suggest it persists far deeper than the root of our tree. For more inerpretation, see \cite{cooper2016cautionary}.}
\label{tab:regressiongym}
\end{table}

\begin{table}[ht]
\centering
\resizebox{\textwidth}{!}{
<<echo=FALSE, results=tex>>=
seedTable <- xtable(seed_results, 
                 caption = "Phylogenetic generalized linear model results for only seed weight for biotic-dispersed subgroup (both group included) and abiotic-dsipersed subgroup. We report the change in log-odds per unit increase of the predictor (Estimate column). We also report the standard error (SE), P-value (with P < 0.05 considered significant and marked with an asterisk next to the Predictor) and the half-life.",
                 label = "tab:regressionseed")
print(seedTable,
      type="latex",
      include.rownames=FALSE,
      floating=FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = identity)
@
}
\caption{Phylogenetic generalized linear model results for only seed weight for biotic-dispersed subgroup (both group included) and abiotic-dsipersed subgroup. We report the change in log-odds per unit increase of the predictor (Estimate column). We also report the standard error (SE), P-value (with P < 0.05 considered significant and marked with an asterisk next to the Predictor) and the half-life (for a description of half-life, see caption of table S1 and S2).}
\label{tab:regressionseed}
\end{table}

\begin{table}[ht]
\centering

<<echo=FALSE, results=tex>>=
lamTable <- xtable(lambda, 
                 caption = "Phylogenetic Signal (Pagel's lambda) for continous traits and multi-level categorical traits. lambda = 0 indicates no phylogenetic signal, trait districuted independent of the phylogeny; 0 < lambda < 1 means moderate phylogenetic signal, trait is partially structured by the phylogeny; lambda = 1 indicates strong phylogenetic signal, trait follows Brownian motion.", 
                 label = "tab:lambda")
print(lamTable,
      type="latex",
      include.rownames=FALSE,
      floating=FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = identity)
@

\caption{Phylogenetic Signal (Pagel's $\lambda$) for continous traits and multi-level categorical traits. $\lambda$ = 0 indicates no phylogenetic signal, trait districuted independent of the phylogeny; 0 < $\lambda$ < 1 means moderate phylogenetic signal, trait is partially structured by the phylogeny; $\lambda$ = 1 indicates strong phylogenetic signal under a Brownian motion of evolution.}
\label{tab:lambda}
\end{table}

\begin{table}[ht]
\centering
\resizebox{\textwidth}{!}{
<<echo=FALSE, results=tex>>=
dStatTable <- xtable(dStat, 
                 caption = "Phylogenetic Signal (D-statistic) for the phylogenetic signal of binary traits, with probabilities calculated under a random phylogenetic structure and under a Brownian motion phylogenetic structure. D = 1 indicates the trait is randomly distributed across the phylogeny; D = 0 indicates the trait follows a Brownian motion model; 0 < D < 1 indivates moderate phylogenetic signal; D < 0 indicates the trait is more clumped than expected under Brownian motion; and D > 1 indicates overdispersion. P random is the p-value for the null hypothesis that the trait is randomly distributed across the phylogeny (no phylogenetic signal), and P Brownian is the p-value for the null hypothesis that the trait follows a Brownian motion model (strong phylogenetic signal). A low p-value indicates rejection of the corresponding null hypothesis.", 
                 label = "tab:dstat")
print(dStatTable,
      type="latex",
      include.rownames=FALSE,
      floating=FALSE,
      sanitize.text.function = identity,
      sanitize.colnames.function = identity)
@
}
\caption{Phylogenetic Signal (D-statistic) for the phylogenetic signal of binary traits, with probabilities calculated under a random phylogenetic structure and under a Brownian motion phylogenetic structure. D = 1 indicates the trait is randomly distributed across the phylogeny; D = 0 indicates the trait follows a Brownian motion model; 0 < D < 1 indivates moderate phylogenetic signal; D < 0 indicates the trait is more clumped than expected under Brownian motion; and D > 1 indicates overdispersion. P random is the p-value for the null hypothesis that the trait is randomly distributed across the phylogeny (no phylogenetic signal), and P Brownian is the p-value for the null hypothesis that the trait follows a Brownian motion model (strong phylogenetic signal). A low p-value indicates rejection of the corresponding null hypothesis.}
\label{tab:dstat}
\end{table}

